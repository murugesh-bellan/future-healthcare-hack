# Vercel AI Gateway / Eve
AI_GATEWAY_API_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# WhatsApp Cloud API credentials, used by @chat-adapter/whatsapp
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Demo persona picker (components/AnonAuthProvider.tsx, app/api/demo-login).
# Speaker ids match the real Prometheux "Undertone Physiological Voice Engine"
# cohort (see lib/prometheux-patients.ts) so a demo login and the clinician
# view's cohort table refer to the same person. Pick your own values, then run
# `node scripts/seed-demo-patients.mjs` to create/rotate the four Supabase
# accounts to match. DEMO_ACCESS_CODE gates /api/demo-login so it isn't a
# public "sign in as any demo patient" route.
DEMO_ACCESS_CODE=
DEMO_PATIENT_SP01_EMAIL=
DEMO_PATIENT_SP01_PASSWORD=
DEMO_PATIENT_SP02_EMAIL=
DEMO_PATIENT_SP02_PASSWORD=
DEMO_PATIENT_SP03_EMAIL=
DEMO_PATIENT_SP03_PASSWORD=
DEMO_PATIENT_SP04_EMAIL=
DEMO_PATIENT_SP04_PASSWORD=
